# GEMINI_API_KEY: Required if server-side Gemini AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Deployed public URL (e.g. https://kyturanaturals.vercel.app)
APP_URL="MY_APP_URL"

# Neon PostgreSQL (automatically injected by Vercel Neon Storage / Marketplace integration)
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob Storage (automatically injected when Vercel Blob is connected)
BLOB_READ_WRITE_TOKEN=

# Optional server-side Admin Passcode & Session Signing Secret (never expose to client)
ADMIN_PASSCODE=
SESSION_SECRET=
